rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========

    // Check if user is god admin (document with adminType='god' exists in admins collection)
    function isGodAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.adminType == 'god';
    }

    // Check if user is any admin (god or sub-admin)
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Check if user is sub-admin (document with adminType='sub' exists in admins collection)
    function isSubAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.adminType == 'sub';
    }

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // ========== COLLECTIONS ==========

    // ADMINS - Any authenticated user can read, god admins setup, sub-admins created by god admin
    match /admins/{adminId} {
      allow read: if isAuthenticated(); // Required for admin status check
      allow create: if isAuthenticated() && (request.auth.uid == adminId || isGodAdmin()); // First-time setup or god admin creating
      allow update: if isAuthenticated() && (request.auth.uid == adminId || isGodAdmin()); // Own profile or god admin
      allow delete: if isGodAdmin(); // Only god admins can delete
    }

    // USERS - Users can read/update own data, admins can read all
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if false; // Never allow user deletion
    }

    // PRODUCTS (Physical) - Public read, any admin can create, only owner or god admin can update/delete
    match /products/{productId} {
      allow read: if true; // Public access for shopping
      allow create: if isAdmin(); // Only admins can add products
      allow update: if isAdmin() && 
                       (resource.data.ownerId == request.auth.uid || isGodAdmin()); // Owner or god admin
      allow delete: if isAdmin() && 
                       (resource.data.ownerId == request.auth.uid || isGodAdmin()); // Owner or god admin
    }

    // CATEGORIES (Physical) - Public read, admins only write
    match /categories/{categoryId} {
      allow read: if true; // Public access for browsing
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ORDERS (Physical) - Users read own, admins read all, sub-admins can only update their own orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() &&
                       (resource.data.adminOwnerId == request.auth.uid || isGodAdmin()); // Owner or god admin
      allow delete: if isAdmin(); // Only admins
    }

    // REVIEWS - Public read for display, users can create, admins can moderate
    match /reviews/{reviewId} {
      allow read: if true; // Public access for product pages
      allow create: if isAuthenticated(); // Any logged-in user
      allow update: if isAdmin() || // Admins can approve/reject/reply
                       (isAuthenticated() && resource.data.userId == request.auth.uid); // Users can vote helpful
      allow delete: if isAdmin(); // Only admins
    }

    // SETTINGS - Authenticated can read, admins can write
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ========== DIGITAL SHOP COLLECTIONS ==========

    // DIGITAL PRODUCTS - Public read, any admin can create, only owner or god admin can update/delete
    match /digital-products/{productId} {
      allow read: if true; // Public access for digital shop
      allow create: if isAdmin();
      allow update: if isAdmin() &&
                       (resource.data.ownerId == request.auth.uid || isGodAdmin());
      allow delete: if isAdmin() &&
                       (resource.data.ownerId == request.auth.uid || isGodAdmin());
    }

    // DIGITAL CATEGORIES - Public read, admins only write
    match /digital-categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // DIGITAL ORDERS - Users read own, admins read all, sub-admins can only update their own
    match /digital-orders/{orderId} {
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() &&
                       (resource.data.adminOwnerId == request.auth.uid || isGodAdmin());
      allow delete: if isAdmin();
    }

    // DIGITAL SETTINGS - Admins only
    match /digital-settings/{settingId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ========== CHAT SYSTEM ==========

    // CHATS - Users can read/write their own chat, admins can read all
    match /chats/{chatId} {
      allow read: if isAuthenticated() && 
                     (request.auth.uid == chatId || isAdmin());
      allow create: if isAuthenticated() && 
                       request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated() && 
                       (request.auth.uid == chatId || isAdmin());
      allow delete: if isAdmin();
    }

    // MESSAGES - Users can create messages to their own chat, admins can send to any
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
                       // User sending to their own chat
                       (request.resource.data.chatId == request.auth.uid && request.resource.data.senderType == 'user') ||
                       // Admin sending to any chat
                       (request.resource.data.senderType == 'admin' && isAdmin())
                     );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ========== AFFILIATE SYSTEM ==========

    // AFFILIATES - Users can read/update own affiliate data, admins can read all
    match /affiliates/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // REFERRALS - Users can read their own referrals, admins can read all
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && 
                     (resource.data.referrerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
                       request.resource.data.referrerId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // AFFILIATE PAYMENTS - Admins only
    match /affiliate-payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
