rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= HELPERS =================

    function isSignedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isGodAdmin() {
      return isAdmin() && adminDoc().adminType == 'god';
    }

    // ================= ADMINS =================
    // CLOSED TO THE CLIENT. Nobody can make themselves an admin from the
    // browser. Create admins in the Firebase Console instead:
    //   Collection: admins  ->  Document ID: <the user's Auth UID>
    //   Fields: adminType = "god" (or "sub"), email = "...", createdAt = <timestamp>
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow create, update, delete: if false;
    }

    // ================= USERS =================
    match /users/{userId} {
      allow read:   if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if false;
    }

    // ================= PRODUCTS =================
    match /products/{productId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin() &&
                               (resource.data.ownerId == request.auth.uid || isGodAdmin());
    }

    match /categories/{categoryId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ================= ORDERS =================
    // A customer may only create an order for themselves, and may not set
    // their own order status.
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.total is number &&
                       request.resource.data.total >= 0;

      allow update: if isAdmin() &&
                       (resource.data.adminOwnerId == request.auth.uid || isGodAdmin());
      allow delete: if isGodAdmin();
    }

    // ================= REVIEWS =================
    // A review is created unapproved and stays hidden until an admin
    // approves it, so nobody can publish spam onto product pages.
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();

      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.helpful == 0 &&
                       request.resource.data.notHelpful == 0;

      allow update, delete: if isAdmin();
    }

    // ================= SETTINGS =================
    // settings/public holds anything the storefront needs (shipping rates,
    // banners). Everything else stays admin-only.
    match /settings/public {
      allow read:  if true;
      allow write: if isGodAdmin();
    }

    match /settings/{settingId} {
      allow read:  if isAdmin();
      allow write: if isGodAdmin();
    }

    // ================= DIGITAL SHOP =================
    match /digital-products/{productId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin() &&
                               (resource.data.ownerId == request.auth.uid || isGodAdmin());
    }

    match /digital-categories/{categoryId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /digital-orders/{orderId} {
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending';

      allow update: if isAdmin() &&
                       (resource.data.adminOwnerId == request.auth.uid || isGodAdmin());
      allow delete: if isGodAdmin();
    }

    match /digital-settings/{settingId} {
      allow read:  if isAdmin();
      allow write: if isGodAdmin();
    }

    // ================= CHAT =================
    // Chat document ID is the customer's UID.
    match /chats/{chatId} {
      allow read:   if isSignedIn() && (request.auth.uid == chatId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == chatId;
      allow update: if isSignedIn() && (request.auth.uid == chatId || isAdmin());
      allow delete: if isAdmin();
    }

    // Customers can only read messages belonging to their own chat.
    match /messages/{messageId} {
      allow read: if isSignedIn() &&
                     (resource.data.chatId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && (
                       (request.resource.data.chatId == request.auth.uid &&
                        request.resource.data.senderType == 'user') ||
                       (request.resource.data.senderType == 'admin' && isAdmin())
                     );

      allow update, delete: if isAdmin();
    }

    // ================= AFFILIATES =================
    // Balance and commission are admin-controlled, so a user editing their
    // own affiliate document cannot change what they are owed.
    match /affiliates/{userId} {
      allow read:   if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() && request.auth.uid == userId &&
                       request.resource.data.balance == 0 &&
                       request.resource.data.totalEarned == 0;

      allow update: if isAdmin() ||
                       (isSignedIn() && request.auth.uid == userId &&
                        request.resource.data.balance == resource.data.balance &&
                        request.resource.data.totalEarned == resource.data.totalEarned &&
                        request.resource.data.commissionRate == resource.data.commissionRate);

      allow delete: if isGodAdmin();
    }

    match /referrals/{referralId} {
      allow read: if isSignedIn() &&
                     (resource.data.referrerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       request.resource.data.referrerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /affiliate-payments/{paymentId} {
      allow read:  if isAdmin();
      allow write: if isGodAdmin();
    }

    // ================= DEFAULT DENY =================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
