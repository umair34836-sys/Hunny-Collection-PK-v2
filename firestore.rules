rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Check if user is admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Check if authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is investor (by code)
    function isInvestor(investorCode) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/investors/$(request.auth.uid));
    }
    
    // ========== MAIN COLLECTIONS ==========
    
    // PRODUCTS (Physical) - Anyone can read, authenticated can write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }
    
    // CATEGORIES (Physical) - Anyone can read, admin can write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ORDERS (Physical) - Authenticated users
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated();
    }
    
    // USERS - Own data
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated();
      allow delete: if false;
    }
    
    // ADMINS - Read only
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    // SETTINGS - Authenticated users
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
    
    // ========== DIGITAL SHOP COLLECTIONS ==========
    
    // DIGITAL PRODUCTS - Anyone can read, authenticated can write
    match /digital-products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }
    
    // DIGITAL CATEGORIES - Anyone can read, admin can write
    match /digital-categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // DIGITAL ORDERS - Own orders or admin
    match /digital-orders/{orderId} {
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    // DIGITAL SETTINGS - Admin only
    match /digital-settings/{settingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ========== INVESTOR MANAGEMENT COLLECTIONS ==========

    // INVESTORS - Admin can write, investor can read own data
    match /investors/{investorId} {
      allow read: if isAdmin() || 
                     (request.auth != null && resource.data.code == request.auth.token.investorCode);
      allow create, update, delete: if isAdmin();
    }

    // INVESTOR EARNINGS - Admin can write, investor can read own earnings
    match /investor_earnings/{earningId} {
      allow read: if isAdmin() || 
                     (request.auth != null && resource.data.investorCode == request.auth.token.investorCode);
      allow create, update, delete: if isAdmin();
    }

    // WITHDRAWAL REQUESTS - Investor can create own, admin can process
    match /withdrawal_requests/{requestId} {
      allow read: if isAdmin() || 
                     (request.auth != null && resource.data.investorCode == request.auth.token.investorCode);
      allow create: if request.auth != null && 
                       request.resource.data.investorCode == request.auth.token.investorCode;
      allow update, delete: if isAdmin();
    }

    // INVESTMENT SETTINGS - Admin only
    match /investment_settings/{settingId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ORDERS - Updated to include investor share data
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
