rules_version = '2';
match /databases/{database}/documents {
  
  // ========== HELPER FUNCTIONS ==========
  
  // Check if user is admin
  function isAdmin() {
    return request.auth != null && 
           exists(/databases/$(database)/documents/admins/$(request.auth.uid));
  }
  
  // Check if user is vendor
  function isVendor() {
    return request.auth != null &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'vendor';
  }
  
  // Check if user is authenticated
  function isAuthenticated() {
    return request.auth != null;
  }
  
  // Validate product data
  function isValidProduct() {
    let data = request.resource.data;
    return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
           data.price is number && data.price >= 0 &&
           data.category is string &&
           data.images is list && data.images.size() > 0;
  }
  
  // ========== COLLECTIONS ==========
  
  // ----- PRODUCTS -----
  // Anyone can read
  // Admin can do anything
  // Vendors can manage their own products (based on vendorId)
  match /products/{productId} {
    allow read: if true;
    
    allow create: if isAuthenticated() && 
                     isValidProduct() &&
                     (isAdmin() || 
                      (isVendor() && request.resource.data.vendorId == request.auth.uid));
    
    allow update: if isAuthenticated() && 
                     isValidProduct() &&
                     (isAdmin() || 
                      (isVendor() && resource.data.vendorId == request.auth.uid));
    
    allow delete: if isAdmin() || 
                     (isVendor() && resource.data.vendorId == request.auth.uid);
  }
  
  // ----- CATEGORIES -----
  // Anyone can read
  // Only admin can write
  match /categories/{categoryId} {
    allow read: if true;
    allow create: if isAdmin();
    allow update: if isAdmin();
    allow delete: if isAdmin();
  }
  
  // ----- ORDERS -----
  // Customers can create and read their own orders
  // Admin can read/update all orders
  // Vendors can read orders containing their products
  match /orders/{orderId} {
    allow read: if isAuthenticated() && 
                   (resource.data.userId == request.auth.uid || 
                    isAdmin() ||
                    (isVendor() && resource.data.items.exists(item, item.vendorId == request.auth.uid)));
    
    allow create: if isAuthenticated() && 
                     request.resource.data.userId == request.auth.uid &&
                     request.resource.data.items is list &&
                     request.resource.data.items.size() > 0 &&
                     request.resource.data.total is number &&
                     request.resource.data.total >= 0;
    
    allow update: if isAuthenticated() && 
                     (isAdmin() || 
                      (resource.data.userId == request.auth.uid && 
                       request.resource.data.keys().only(['status', 'updatedAt', 'notes']).size() > 0));
    
    allow delete: if isAdmin();
  }
  
  // ----- USERS -----
  // Users can read/write their own data
  // Admin can read all users
  match /users/{userId} {
    allow read: if isAuthenticated() && 
                   (request.auth.uid == userId || isAdmin());
    
    allow create: if isAuthenticated() && request.auth.uid == userId;
    
    allow update: if isAuthenticated() && 
                     (request.auth.uid == userId || isAdmin());
    
    allow delete: if false;
  }
  
  // ----- ADMINS -----
  // Only readable by authenticated users
  // Cannot be modified from client
  match /admins/{adminId} {
    allow read: if isAuthenticated();
    allow create: if false;
    allow update: if false;
    allow delete: if false;
  }
  
  // ----- SETTINGS -----
  // Anyone can read
  // Only admin can write
  match /settings/{settingId} {
    allow read: if true;
    allow create: if isAdmin();
    allow update: if isAdmin();
    allow delete: if isAdmin();
  }
}
