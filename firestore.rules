rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Check if authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ========== MAIN COLLECTIONS ==========
    
    // PRODUCTS (Physical) - Anyone can read, authenticated can write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }
    
    // CATEGORIES (Physical) - Anyone can read, admin can write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ORDERS (Physical) - Authenticated users
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated();
    }
    
    // USERS - Own data
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated();
      allow delete: if false;
    }
    
    // ADMINS - Read only
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    // SETTINGS - Authenticated users
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
    
    // ========== DIGITAL SHOP COLLECTIONS ==========
    
    // DIGITAL PRODUCTS - Anyone can read, authenticated can write
    match /digital-products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }
    
    // DIGITAL CATEGORIES - Anyone can read, admin can write
    match /digital-categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // DIGITAL ORDERS - Own orders or admin
    match /digital-orders/{orderId} {
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    // DIGITAL SETTINGS - Admin only
    match /digital-settings/{settingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
  }
}
